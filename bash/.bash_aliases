# Personal aliases — loaded from ~/.bashrc after Omarchy defaults

alias ,cl='clear'
alias ,c='claude'   # overrides Omarchy's c='opencode --auto'
alias ,e='exit'
alias ,tko='for s in 1 2 3 4; do tmux kill-session -t "=$s" 2>/dev/null; done'

alias ,lg='lazygit'
alias ,gs='git status'
alias ,gco='git checkout'
alias ,g='git status'
