# Dynamic theme colors
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

# Font
font-family = "Terminess Nerd Font"
font-style = Regular
font-size = 9

# Window
window-theme = ghostty
window-padding-x = 14
window-padding-y = 14
confirm-close-surface=false
resize-overlay = never
gtk-toolbar-style = flat

# Cursor styling
cursor-style = "block"
cursor-style-blink = false

# Cursor styling + SSH session terminfo
# (all shell integration options must be passed together)
shell-integration-features = no-cursor,ssh-env

# Keyboard bindings
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard
# Send Shift+Enter as CSI-u so TUIs can distinguish it from Enter.
keybind = shift+enter=csi:13;2u
# Legacy encoding sends Alt+Shift+Enter the same as Alt+Enter; send CSI-u so tmux can match M-S-Enter.
keybind = alt+shift+enter=csi:13;4u
# Send Ctrl+Shift+Space as CSI-u so tmux can tell it from Ctrl+Space (its prefix) — opens the tmux switcher.
keybind = ctrl+shift+space=csi:32;6u
keybind = super+control+shift+alt+arrow_down=resize_split:down,100
keybind = super+control+shift+alt+arrow_up=resize_split:up,100
keybind = super+control+shift+alt+arrow_left=resize_split:left,100
keybind = super+control+shift+alt+arrow_right=resize_split:right,100

# Slowdown mouse scrolling
mouse-scroll-multiplier = 0.95

# Fix general slowness on hyprland (https://github.com/ghostty-org/ghostty/discussions/3224)
async-backend = epoll

# Free meh+j for Neovim (vim-move line down); Ghostty binds it to write_screen_file by default
keybind = ctrl+alt+shift+j=unbind

## Imported from voyager-xyz/dotfiles (Linux-compatible settings only)
keybind = ctrl+tab=unbind
mouse-hide-while-typing = true

# Clipboard
clipboard-read = allow
clipboard-paste-protection = false

# Cell sizing
adjust-cell-width = 3%
adjust-cell-height = 20%

# Performance: scrollback lives in tmux; no inline-image use
scrollback-limit = 1000000
image-storage-limit = 16000000

# Cursor shader (pick another from ./shaders)
custom-shader = ~/.config/ghostty/shaders/ripple_rectangle_cursor.glsl

# Start every window in persistent tmux session "1" (of four, 5 windows each).
# Apps launched with `ghostty -e ...` (btop, etc.) still bypass this.
command = ~/.local/bin/tmux-main

# Hand tmux the keys it uses: Alt+1-9 (windows) and Ctrl+Alt+Arrows (panes).
keybind = alt+digit_1=unbind
keybind = alt+digit_2=unbind
keybind = alt+digit_3=unbind
keybind = alt+digit_4=unbind
keybind = alt+digit_5=unbind
keybind = alt+digit_6=unbind
keybind = alt+digit_7=unbind
keybind = alt+digit_8=unbind
keybind = alt+1=unbind
keybind = alt+2=unbind
keybind = alt+3=unbind
keybind = alt+4=unbind
keybind = alt+5=unbind
keybind = alt+6=unbind
keybind = alt+7=unbind
keybind = alt+8=unbind
keybind = alt+9=unbind
keybind = ctrl+alt+arrow_up=unbind
keybind = ctrl+alt+arrow_down=unbind
keybind = ctrl+alt+arrow_left=unbind
keybind = ctrl+alt+arrow_right=unbind
