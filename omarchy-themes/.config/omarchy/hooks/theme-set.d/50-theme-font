#!/bin/bash
# Give each theme its own monospace font. A theme's font.txt lists fonts, one
# per line, best first; the first one installed is applied with
# `omarchy font set`. Each line is matched case-insensitively against the
# installed families, and the shortest match wins, so "Hack Nerd Font" picks
# "Hack Nerd Font" over "Hack Nerd Font Mono"/"Propo".
# A theme without font.txt (or with none of its fonts installed) gets the
# default back: whatever font was set before the first themed one replaced
# it, saved in ~/.local/state/omarchy/font.default.
# $1 holds the theme slug.
set -u

DEFAULT="$HOME/.local/state/omarchy/font.default"

font_file=""
for f in "$HOME/.local/state/omarchy/current/theme/font.txt" \
         "$HOME/.config/omarchy/themes/${1:-}/font.txt"; do
  [[ -f $f ]] && font_file=$f && break
done

families=$(fc-list : family | tr ',' '\n' | sort -u)

resolve() {
  local want=$1
  [[ -n $want ]] || return 1
  grep -Fi -- "$want" <<<"$families" | awk '{ print length, $0 }' | sort -n | head -1 | cut -d' ' -f2-
}

current=$(omarchy-font-current 2>/dev/null || true)
mkdir -p "${DEFAULT%/*}"

target=""
if [[ -n $font_file ]]; then
  # Remember the user's own font before the first themed one replaces it.
  [[ -f $DEFAULT || -z $current ]] || printf '%s\n' "$current" >"$DEFAULT"

  while IFS= read -r line || [[ -n $line ]]; do
    line=${line%%#*}
    line=$(echo "$line" | xargs)
    target=$(resolve "$line") && [[ -n $target ]] && break
  done <"$font_file"
fi

if [[ -z $target && -f $DEFAULT ]]; then
  target=$(resolve "$(<"$DEFAULT")")
fi

[[ -n $target && $target != "$current" ]] || exit 0
omarchy-font-set "$target" >/dev/null
