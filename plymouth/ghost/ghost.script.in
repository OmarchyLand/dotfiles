# ghost: movie-terminal boot splash.
#
# Generated by `plymouth-ghost sync` from the Omarchy theme "@THEME@".
# Edit plymouth/ghost/ghost.script.in in the dotfiles repo, not the installed copy.
#
# A black screen of scrolling boot text in the theme's colours. Real systemd
# status lines show in the accent colour between fake kernel chatter; the LUKS
# passphrase prompt clears the screen and asks in the middle.

#----------------------------------------- Colours (from colors.toml) -----------

global.bg_r = @BG_R@;     global.bg_g = @BG_G@;     global.bg_b = @BG_B@;
global.fg_r = @FG_R@;     global.fg_g = @FG_G@;     global.fg_b = @FG_B@;
global.ac_r = @AC_R@;     global.ac_g = @AC_G@;     global.ac_b = @AC_B@;
global.dim_r = @DIM_R@;   global.dim_g = @DIM_G@;   global.dim_b = @DIM_B@;
global.host = "@HOST@";

Window.SetBackgroundTopColor(global.bg_r, global.bg_g, global.bg_b);
Window.SetBackgroundBottomColor(global.bg_r, global.bg_g, global.bg_b);

# Names containing "Mono" use the theme's MonospaceFont; "Bold" its bold face.
global.font = "Monospace 11";
global.font_bold = "Monospace Bold 11";
global.font_big = "Monospace Bold 16";

#----------------------------------------- State --------------------------------

global.mode = Plymouth.GetMode();
global.halting = (global.mode == "shutdown" || global.mode == "reboot");

global.margin = 36;
probe = Image.Text("Mg", 1, 1, 1, 1, global.font);
global.line_h = probe.GetHeight() + 4;

global.images = [];      # log line images, oldest first
global.sprites = [];     # one sprite per visible row
global.count = 0;
global.max_lines = 1;

global.frame = 0;
global.prompting = 0;
global.log_hidden = 0;
global.prompt_text = "";
global.entry_text = "";
global.entry_secret = 1;
global.entry_len = 0;
global.cursor_on = 1;
global.last_percent = -1;

global.layout_w = 0;
global.layout_h = 0;

global.hexd = [];
for (i = 0; i < 10; i++) global.hexd[i] = "" + i;
global.hexd[10] = "a"; global.hexd[11] = "b"; global.hexd[12] = "c";
global.hexd[13] = "d"; global.hexd[14] = "e"; global.hexd[15] = "f";

header_sprite = Sprite();
subheader_sprite = Sprite();
footer_sprite = Sprite();
prompt_title_sprite = Sprite();
prompt_label_sprite = Sprite();
prompt_entry_sprite = Sprite();

#----------------------------------------- Helpers ------------------------------

fun text_image(str, r, g, b, font) {
  if (str == "") str = " ";
  return Image.Text(str, r, g, b, 1, font);
}

fun rand_int(n) {
  v = Math.Int(Math.Random() * n);
  if (v >= n) v = n - 1;
  return v;
}

# Plymouth's script language has no modulo operator to rely on.
fun every(n) {
  return global.frame == Math.Int(global.frame / n) * n;
}

fun hex(n) {
  s = "";
  for (i = 0; i < n; i++) s = s + global.hexd[rand_int(16)];
  return s;
}

fun ip() {
  return (rand_int(223) + 1) + "." + rand_int(256) + "." + rand_int(256) + "." + (rand_int(254) + 1);
}

fun pad6(n) {
  s = "" + n;
  if (n < 100000) s = "0" + s;
  if (n < 10000) s = "0" + s;
  if (n < 1000) s = "0" + s;
  if (n < 100) s = "0" + s;
  if (n < 10) s = "0" + s;
  return s;
}

fun pad5(n) {
  s = "" + n;
  if (n < 10000) s = " " + s;
  if (n < 1000) s = " " + s;
  if (n < 100) s = " " + s;
  if (n < 10) s = " " + s;
  return s;
}

# Kernel-style "[   12.034511]" timestamp from frames since start (50 fps).
fun stamp() {
  t = global.frame / 50.0;
  sec = Math.Int(t);
  usec = Math.Int((t - sec) * 1000000);
  return "[" + pad5(sec) + "." + pad6(usec) + "] ";
}

#----------------------------------------- Log ----------------------------------

fun redraw_log() {
  for (i = 0; i < global.count; i++) {
    if (!global.sprites[i]) global.sprites[i] = Sprite();
    global.sprites[i].SetImage(global.images[i]);
    global.sprites[i].SetPosition(global.margin, global.log_top + i * global.line_h, 1);
    if (global.log_hidden) { global.sprites[i].SetOpacity(0); }
    else { global.sprites[i].SetOpacity(1); }
  }
  for (i = global.count; global.sprites[i]; i++) global.sprites[i].SetOpacity(0);
}

fun add_line(str, r, g, b, font) {
  img = text_image(str, r, g, b, font);
  if (global.count < global.max_lines) {
    global.images[global.count] = img;
    global.count++;
  } else {
    for (i = 0; i < global.max_lines - 1; i++) global.images[i] = global.images[i + 1];
    global.images[global.max_lines - 1] = img;
  }
  redraw_log();
}

fun set_log_hidden(hidden) {
  global.log_hidden = hidden;
  redraw_log();
}

#----------------------------------------- Fake chatter -------------------------

fun boot_chatter() {
  k = rand_int(12);
  if (k == 0) return "mem: mapping segment 0x" + hex(12) + "-0x" + hex(12);
  if (k == 1) {
    m = rand_int(6);
    if (m == 0) return "loading module ghost_net.ko ... ok";
    if (m == 1) return "loading module icebreaker.ko ... ok";
    if (m == 2) return "loading module xts_aes_ni.ko ... ok";
    if (m == 3) return "loading module daemon_mux.ko ... ok";
    if (m == 4) return "loading module shadowfs.ko ... ok";
    return "loading module trace_scrub.ko ... ok";
  }
  if (k == 2) return "crypto: aes-xts-plain64 key schedule verified [" + hex(8) + "]";
  if (k == 3) return "net: probing uplink " + ip() + " ... ACK";
  if (k == 4) return "pci 0000:" + hex(2) + ":" + hex(2) + "." + rand_int(8) + ": [" + hex(4) + ":" + hex(4) + "] claimed";
  if (k == 5) return "integrity: sha256 " + hex(32) + " ok";
  if (k == 6) return "tpm: sealing channel " + hex(4) + ":" + hex(4) + ":" + hex(4);
  if (k == 7) return "proc: spawning daemon pid " + (rand_int(30000) + 300);
  if (k == 8) return "tcp: handshake " + ip() + ":" + (rand_int(60000) + 1024) + " seq=" + rand_int(999999);
  if (k == 9) return "route: tunnel " + hex(4) + " -> " + ip() + " established";
  if (k == 10) return "trace: scrubbing " + (rand_int(9000) + 100) + " log entries";
  return "irq " + rand_int(128) + ": vector 0x" + hex(2) + " bound to cpu" + rand_int(16);
}

fun halt_chatter() {
  k = rand_int(6);
  if (k == 0) return "proc: sending SIGTERM to pid " + (rand_int(30000) + 300);
  if (k == 1) return "crypto: wiping session key [" + hex(16) + "]";
  if (k == 2) return "net: dropping link " + ip() + " ... gone";
  if (k == 3) return "fs: sync " + hex(8) + " dirty pages flushed";
  if (k == 4) return "trace: shredding " + (rand_int(9000) + 100) + " entries";
  return "mem: zeroing segment 0x" + hex(12);
}

#----------------------------------------- Layout -------------------------------

fun layout() {
  global.layout_w = Window.GetWidth();
  global.layout_h = Window.GetHeight();

  header_sprite.SetPosition(global.margin, global.margin, 2);
  subheader_sprite.SetPosition(global.margin, global.margin + global.line_h, 2);

  global.log_top = global.margin + 3 * global.line_h;
  global.max_lines = Math.Int((global.layout_h - global.log_top - global.margin - 2 * global.line_h) / global.line_h);
  if (global.max_lines < 1) global.max_lines = 1;

  # Display got smaller: keep only the newest lines that still fit.
  if (global.count > global.max_lines) {
    drop = global.count - global.max_lines;
    for (i = 0; i < global.max_lines; i++) global.images[i] = global.images[i + drop];
    global.count = global.max_lines;
  }

  footer_sprite.SetPosition(global.margin, global.layout_h - global.margin - global.line_h, 2);
  redraw_log();
  draw_prompt();
}

#----------------------------------------- Header / footer ----------------------

if (global.halting) { title = "GHOST-OS :: " + global.host + " :: SYSTEM HALT"; }
else { title = "GHOST-OS :: " + global.host + " :: SECURE BOOT"; }
header_sprite.SetImage(text_image(title, global.ac_r, global.ac_g, global.ac_b, global.font_bold));
subheader_sprite.SetImage(text_image("profile @THEME@  //  mode " + global.mode, global.dim_r, global.dim_g, global.dim_b, global.font));

fun progress_callback(duration, progress) {
  percent = Math.Int(progress * 100);
  if (percent > 100) percent = 100;
  if (percent == global.last_percent) return;
  global.last_percent = percent;

  bar = "";
  filled = Math.Int(percent * 40 / 100);
  for (i = 0; i < 40; i++) {
    if (i < filled) { bar = bar + "#"; }
    else { bar = bar + "."; }
  }
  footer_sprite.SetImage(text_image("[" + bar + "] " + percent + "%", global.ac_r, global.ac_g, global.ac_b, global.font));
}

Plymouth.SetBootProgressFunction(progress_callback);

#----------------------------------------- Passphrase / questions ---------------

fun draw_prompt() {
  if (!global.prompting) {
    prompt_title_sprite.SetOpacity(0);
    prompt_label_sprite.SetOpacity(0);
    prompt_entry_sprite.SetOpacity(0);
    return;
  }

  if (global.entry_secret) {
    shown = "";
    n = global.entry_len;
    if (n > 40) n = 40;
    for (i = 0; i < n; i++) shown = shown + "*";
  } else {
    shown = global.entry_text;
  }
  if (global.cursor_on) { shown = shown + "_"; }
  else { shown = shown + " "; }

  title_img = text_image(">> ENCRYPTED VOLUME DETECTED <<", global.ac_r, global.ac_g, global.ac_b, global.font_big);
  label_img = text_image("> " + global.prompt_text, global.fg_r, global.fg_g, global.fg_b, global.font);
  entry_img = text_image("KEY: " + shown, global.ac_r, global.ac_g, global.ac_b, global.font_big);

  prompt_title_sprite.SetImage(title_img);
  prompt_label_sprite.SetImage(label_img);
  prompt_entry_sprite.SetImage(entry_img);

  cy = global.layout_h / 2;
  prompt_title_sprite.SetPosition(global.layout_w / 2 - title_img.GetWidth() / 2, cy - 3 * global.line_h, 10);
  prompt_label_sprite.SetPosition(global.layout_w / 2 - label_img.GetWidth() / 2, cy - global.line_h, 10);
  # Left-align the entry from a fixed point so it does not wobble as it grows.
  prompt_entry_sprite.SetPosition(global.layout_w / 2 - 12 * global.line_h, cy + global.line_h, 10);

  prompt_title_sprite.SetOpacity(1);
  prompt_label_sprite.SetOpacity(1);
  prompt_entry_sprite.SetOpacity(1);
}

fun begin_prompt(prompt, secret, entry_len, entry_text) {
  if (prompt == "") prompt = "Passphrase";
  global.prompt_text = prompt;
  global.entry_secret = secret;
  global.entry_len = entry_len;
  global.entry_text = entry_text;
  global.prompting = 1;
  set_log_hidden(1);
  draw_prompt();
}

fun display_password_callback(prompt, bullets) {
  begin_prompt(prompt, 1, bullets, "");
}

fun display_question_callback(prompt, entry) {
  begin_prompt(prompt, 0, 0, entry);
}

fun display_normal_callback() {
  if (!global.prompting) return;
  global.prompting = 0;
  draw_prompt();
  set_log_hidden(0);
  add_line(stamp() + "[  OK  ] key accepted :: ACCESS GRANTED", global.ac_r, global.ac_g, global.ac_b, global.font_bold);
}

Plymouth.SetDisplayPasswordFunction(display_password_callback);
Plymouth.SetDisplayQuestionFunction(display_question_callback);
Plymouth.SetDisplayNormalFunction(display_normal_callback);

#----------------------------------------- Real status / messages ---------------

fun update_status_callback(status) {
  if (status == "") return;
  add_line(stamp() + "[  OK  ] " + status, global.ac_r, global.ac_g, global.ac_b, global.font);
}

fun display_message_callback(text) {
  if (text == "") return;
  add_line(stamp() + "[ INFO ] " + text, global.fg_r, global.fg_g, global.fg_b, global.font);
}

fun hide_message_callback(text) {
}

Plymouth.SetUpdateStatusFunction(update_status_callback);
Plymouth.SetDisplayMessageFunction(display_message_callback);
Plymouth.SetHideMessageFunction(hide_message_callback);

#----------------------------------------- Refresh (50 fps) ---------------------

fun refresh_callback() {
  # Displays can appear after start (e.g. Thunderbolt); re-lay out on resize.
  if (Window.GetWidth() != global.layout_w || Window.GetHeight() != global.layout_h) layout();

  global.frame++;

  if (global.prompting) {
    if (every(25)) {
      global.cursor_on = !global.cursor_on;
      draw_prompt();
    }
    return;
  }

  # A burst at the start, then a steady scroll.
  rate = 6;
  if (global.frame < 100) rate = 3;
  if (every(rate)) {
    if (global.halting) { line = halt_chatter(); }
    else { line = boot_chatter(); }
    add_line(stamp() + line, global.dim_r, global.dim_g, global.dim_b, global.font);
  }
}

Plymouth.SetRefreshFunction(refresh_callback);

layout();
progress_callback(0, 0);
