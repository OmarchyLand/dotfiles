#!/bin/bash
# Make sure the four persistent tmux sessions "1".."4" exist, each with 5
# windows (more if a session has more apps than that), then attach to
# session 1. Used as Ghostty's `command`.
#   tmux-main --ensure   only create missing sessions (used by tmux key binds)
# Switch sessions with / held + q w e r  (keyd sends Alt+F9..F12 to tmux).
#
# Session 3 opens the productivity apps and session 4 the entertainment apps,
# one per window (the TUIs from ~/Work/apps, `jdf-<app>-cli`). Each is started
# from a shell, so quitting an app leaves a prompt in its window.

productivity=(mail calendar reminders notes vault cost-control super-tracker)
entertainment=(tube reddit been browsing)

for S in 1 2 3 4; do
  tmux has-session -t "=$S" 2>/dev/null && continue
  # One-time migration from the old single "main" session.
  if [[ $S == 1 ]] && tmux has-session -t "=main" 2>/dev/null; then
    tmux rename-session -t "=main" 1
    continue
  fi
  apps=()
  [[ $S == 3 ]] && apps=("${productivity[@]}")
  [[ $S == 4 ]] && apps=("${entertainment[@]}")
  windows=$(( ${#apps[@]} > 5 ? ${#apps[@]} : 5 ))

  tmux new-session -d -s "$S" -c ~
  for _ in $(seq 2 "$windows"); do tmux new-window -t "=$S:" -c ~; done

  for i in "${!apps[@]}"; do
    cmd="jdf-${apps[$i]}-cli"
    command -v "$cmd" >/dev/null || continue
    tmux send-keys -t "=$S:$((i + 1))" "$cmd" Enter
  done

  tmux select-window -t "=$S:1"
done

[[ $1 == --ensure ]] && exit 0
exec tmux attach-session -t "=1"
