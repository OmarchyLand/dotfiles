#!/bin/bash
# Fuzzy switcher for every window in every tmux session, listed with the
# programs running in its panes. Opened in a popup by Ctrl+Shift+Space
# (see ~/.config/tmux/tmux.conf). Type to filter (e.g. "3 mail", "nvim"),
# Enter to jump there, Esc to cancel. The preview shows the window's contents.
#   tmux-switch --list            print the list only
#   tmux-switch --preview S:W     draw the preview for window S:W
# Colours come from the current Omarchy theme's colors.toml, read on every
# run, so the switcher follows `omarchy theme set` without a reload.

theme=$HOME/.local/state/omarchy/current/theme/colors.toml

# Theme colour by name ("accent", "muted", ...), as #rrggbb; $2 if unset.
color() {
  local v
  [[ -r $theme ]] && v=$(sed -n "s/^$1 *= *\"\(#[0-9a-fA-F]\{6\}\)\".*/\1/p" "$theme")
  echo "${v:-$2}"
}

# SGR foreground for a #rrggbb colour, with optional extra attrs: "1;38;2;r;g;b"
sgr() {
  local h=${1#\#}
  printf '%s38;2;%d;%d;%d' "${2:+$2;}" "0x${h:0:2}" "0x${h:2:2}" "0x${h:4:2}"
}

c_accent=$(color accent '#7aa2f7')
c_fg=$(color foreground '#c0caf5')
c_bright=$(color bright_foreground "$c_fg")
c_dim=$(color dark_foreground '#737aa2')
c_muted=$(color muted '#414868')
c_sel=$(color selection '#283457')
c_yellow=$(color yellow '#e0af68')

list() {
  # Programs per window, in pane order, de-duplicated: "nvim, bash"
  local procs
  procs=$(tmux list-panes -a -F '#{session_name}:#{window_index}	#{pane_current_command}' |
    awk -F'\t' '{ if (!seen[$0]++) p[$1] = ($1 in p) ? p[$1] ", " $2 : $2 }
                END { for (k in p) print k "\t" p[k] }')

  tmux list-windows -a -F '#{session_name}:#{window_index}	#{?session_attached,1,0}#{window_active}	#{window_name}	#{pane_current_path}' |
    awk -F'\t' -v procs="$procs" -v home="$HOME" \
        -v acc="$(sgr "$c_accent" 1)" -v prog="$(sgr "$c_bright" 1)" \
        -v name="$(sgr "$c_yellow")" -v dir="$(sgr "$c_dim")" '
      BEGIN { n = split(procs, l, "\n"); for (i = 1; i <= n; i++) { split(l[i], f, "\t"); p[f[1]] = f[2] } }
      {
        if (index($4, home) == 1) $4 = "~" substr($4, length(home) + 1)
        mark = ($2 == "11") ? "\033[" acc "m▶\033[0m" : " "
        printf "%s\t%s \033[%sm%-5s\033[0m \033[%sm%-24.24s\033[0m \033[%sm%-22.22s\033[0m \033[%sm%s\033[0m\n",
          $1, mark, acc, $1, prog, p[$1], name, $3, dir, $4
      }'
}

# Every pane of the window, each under a header naming its program. The
# space is split evenly between the panes; the active one is highlighted.
preview() {
  local target=$1 rows=${FZF_PREVIEW_LINES:-40} cols=${FZF_PREVIEW_COLUMNS:-80}
  local panes n each
  panes=$(tmux list-panes -t "=$target" -F '#{pane_id}	#{pane_index}	#{pane_active}	#{pane_current_command}	#{pane_current_path}	#{alternate_on}')
  n=$(wc -l <<<"$panes")
  each=$(( rows / n - 1 ))
  (( each < 2 )) && each=2

  while IFS=$'\t' read -r -u 3 id idx active cmd path fullscreen; do
    [[ $path == "$HOME"* ]] && path="~${path#"$HOME"}"
    local color label="pane $idx"
    color=$(sgr "$c_dim")
    [[ $active == 1 ]] && color=$(sgr "$c_accent" 1)
    local head="── $label · $cmd · $path "
    local fill=$(( cols - ${#head} )) line
    (( fill > 0 )) && printf -v line '%*s' "$fill" '' && head+=${line// /─}
    printf '\033[%sm%s\033[0m\n' "$color" "$head"
    # Full-screen apps (nvim, top, the *-cli TUIs): show the top of the screen.
    # Shells: drop trailing blank lines and show the newest lines.
    if [[ $fullscreen == 1 ]]; then
      tmux capture-pane -ep -t "$id" | head -n "$each"
    else
      tmux capture-pane -ep -t "$id" |
        awk '{ l[NR] = $0 } /[^[:space:]]/ { last = NR } END { for (i = 1; i <= last; i++) print l[i] }' |
        tail -n "$each"
    fi
  done 3<<<"$panes"
}

case $1 in
  --list) list; exit 0 ;;
  --preview) preview "$2"; exit 0 ;;
esac

menu=$(list)
# Start with the cursor on the window we came from.
current=$(tmux display-message -p '#{session_name}:#{window_index}')
pos=$(awk -F'\t' -v c="$current" '$1 == c { print NR; exit }' <<<"$menu")

target=$(fzf <<<"$menu" \
  --ansi --no-sort --layout=reverse --cycle \
  --delimiter='\t' --with-nth=2 --nth=1.. \
  --prompt='  ' --info=inline-right \
  --header='enter: switch   esc: cancel' \
  --bind="load:pos(${pos:-1})" \
  --preview="$0 --preview {1}" \
  --preview-window='down,60%,border-top' \
  --color="fg:$c_fg,bg:-1,hl:$c_accent,fg+:$c_bright,bg+:$c_sel,hl+:$c_accent:bold" \
  --color="prompt:$c_accent,pointer:$c_accent,marker:$c_accent,spinner:$c_accent" \
  --color="info:$c_dim,header:$c_dim,border:$c_muted,separator:$c_muted,scrollbar:$c_muted" \
  --color="gutter:-1,query:$c_bright,preview-fg:$c_fg,preview-bg:-1" |
  cut -f1)

[[ -n $target ]] && tmux switch-client -t "=$target"
