#!/usr/bin/env bash
# ports — show listening sockets (ss -tulpn), then explain what's on each port:
# process, user, systemd unit, owning package, well-known service name and
# whether it's reachable from the network or only from this machine.
# Re-runs itself with sudo so root-owned services show their process
# (pass --no-sudo to skip that; root processes will then show as "unknown").
set -uo pipefail

if [[ ${1:-} == --no-sudo ]]; then
  shift
elif [[ $EUID -ne 0 ]] && command -v sudo >/dev/null; then
  # Use sudo if credentials are cached or we have a terminal to prompt on;
  # otherwise (e.g. run from a non-interactive shell) carry on unprivileged.
  if sudo -n true 2>/dev/null || [[ -t 0 ]]; then
    exec sudo "$0" --no-sudo "$@"
  fi
  echo "ports: no terminal for a sudo password — showing only your own processes" >&2
  echo >&2
fi

if [[ -t 1 ]]; then
  B=$'\e[1m' D=$'\e[2m' R=$'\e[31m' Y=$'\e[33m' G=$'\e[32m' N=$'\e[0m'
else
  B= D= R= Y= G= N=
fi

echo "${B}== ss -tulpn ==${N}"
ss -tulpn
echo

exposure() {
  case $1 in
    127.*|'[::1]'|*%lo) echo "${G}localhost only${N}" ;;
    0.0.0.0|'[::]'|'*') echo "${R}ALL interfaces (reachable from the network)${N}" ;;
    172.17.*|172.18.*|'[fe80'*) echo "${Y}local/virtual interface ($1)${N}" ;;
    *) echo "${Y}interface $1${N}" ;;
  esac
}

# Group sockets by proto/port/pid so the same service on IPv4 + IPv6 or on
# several loopback addresses is shown once.
declare -A addrs
order=()
while read -r proto _ _ _ local _ procinfo; do
  port=${local##*:}
  addr=${local%:*}
  pid=$(grep -o 'pid=[0-9]*' <<<"${procinfo:-}" | head -1 | cut -d= -f2)
  key="$proto|$port|${pid:-}"
  if [[ -z ${addrs[$key]+x} ]]; then
    order+=("$key")
    addrs[$key]=$addr
  else
    addrs[$key]+=" $addr"
  fi
done < <(ss -tulpnH)

# WireGuard tunnels listen on a UDP socket owned by the kernel, so ss never
# shows a process for them. As root `wg` gives the exact port; otherwise we
# can only say an unexplained wildcard UDP port is probably the tunnel.
declare -A wg_port wg_conn
wg_ifaces=$(ip -br link show type wireguard 2>/dev/null | awk '{print $1}' | xargs)
while IFS=: read -r cname cdev; do
  [[ -n $cdev ]] && wg_conn[$cdev]=$cname
done < <(nmcli -t -f NAME,DEVICE connection show --active 2>/dev/null | sed 's/\\:/;/g')
if [[ $EUID -eq 0 && -n $wg_ifaces ]] && command -v wg >/dev/null; then
  while read -r iface p; do
    [[ -n $p && $p != 0 ]] && wg_port[$p]=$iface
  done < <(wg show all listen-port 2>/dev/null)
fi
wg_label() { echo "$1${wg_conn[$1]:+ — ${wg_conn[$1]}}"; }

printf '%s\n' "${order[@]}" | sort -t'|' -k2,2n -k1,1 | while IFS='|' read -r proto port pid; do
  key="$proto|$port|$pid"
  svc=$(getent services "$port/$proto" | awk '{print $1}')
  echo "${B}${proto^^} ${port}${N}${svc:+  ${D}(IANA default: $svc)${N}}"

  # Worst-case exposure across all addresses this service listens on.
  exp_line=
  for a in ${addrs[$key]}; do
    e=$(exposure "$a")
    if [[ $e == *ALL* ]]; then exp_line=$e; break; fi
    [[ -z $exp_line || $e != *localhost* ]] && exp_line=$e
  done
  echo "  listen:  ${addrs[$key]}"
  echo "  access:  $exp_line"

  if [[ -n $pid && -d /proc/$pid ]]; then
    name=$(ps -o comm= -p "$pid")
    user=$(ps -o user= -p "$pid")
    unit=$(ps -o unit= -p "$pid" 2>/dev/null | xargs)
    exe=$(readlink -f "/proc/$pid/exe" 2>/dev/null)
    pkg=$( [[ -n $exe ]] && pacman -Qqo "$exe" 2>/dev/null )
    cmd=$(tr '\0' ' ' <"/proc/$pid/cmdline" | cut -c1-150)
    echo "  process: $name (pid $pid, user $user)"
    [[ -n $unit && $unit != - ]] && echo "  unit:    $unit"
    echo "  package: ${pkg:-${D}not from a package${N}}${exe:+  ${D}$exe${N}}"
    echo "  command: $cmd"
  elif [[ $proto == udp && -n ${wg_port[$port]:-} ]]; then
    echo "  process: kernel WireGuard tunnel ($(wg_label "${wg_port[$port]}"))"
    echo "  note:    ${D}drops any packet not signed with the tunnel's key — looks closed to scanners${N}"
  elif [[ $proto == udp && $EUID -ne 0 && -n $wg_ifaces && $exp_line == *ALL* ]]; then
    labels=$(for i in $wg_ifaces; do wg_label "$i"; done | paste -sd, - | sed 's/,/, /g')
    echo "  process: ${D}unknown — probably the kernel WireGuard tunnel ($labels); run with sudo to confirm${N}"
  else
    echo "  process: ${D}unknown (no process info — run with sudo, or a kernel/container socket)${N}"
  fi
  echo
done
