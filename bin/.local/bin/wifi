#!/usr/bin/env bash
# Pick a Wi-Fi network with fzf and connect to it via NetworkManager.
# Saved networks reconnect with their stored credentials; new secured ones
# prompt for the password.
set -euo pipefail

echo "Scanning..." >&2
# SSID goes last so colons inside it survive splitting on the first four.
list=$(nmcli -t --escape no -f IN-USE,SIGNAL,BARS,SECURITY,SSID dev wifi list --rescan yes |
  awk -F: '{
    inuse=$1; sig=$2; bars=$3; sec=$4
    ssid=$0; for (i = 0; i < 4; i++) sub(/^[^:]*:/, "", ssid)
    if (ssid == "") next
    if (inuse == "*") conn[ssid] = 1
    if (!(ssid in best) || sig + 0 > best[ssid] + 0) { best[ssid] = sig; b[ssid] = bars; sc[ssid] = (sec == "" ? "open" : sec) }
  } END {
    for (s in best)
      printf "%s\t%s %-4s %3s%%  %-14s %s\t%s\n", best[s], (s in conn ? "●" : " "), b[s], best[s], sc[s], s, s
  }' |
  sort -t$'\t' -k1,1nr | cut -f2-)

[ -n "$list" ] || { echo "No networks found." >&2; exit 1; }

# The raw SSID rides along in a hidden second tab-separated field.
choice=$(fzf --prompt="wifi> " --header="● = connected" --no-sort --reverse --height=40% \
  --delimiter=$'\t' --with-nth=1 <<<"$list") || exit 0
ssid=${choice#*$'\t'}

if nmcli -t --escape no -f NAME,TYPE connection show | grep -qxF "$ssid:802-11-wireless"; then
  nmcli connection up id "$ssid"
else
  nmcli --ask dev wifi connect "$ssid"
fi
